role PrensaPublico
	modelPermission: read

	/// Object-level security (statistical disclosure control): no age breakdown, because
	/// small counts by department x age group x week can identify people, and no data
	/// quality internals (mart_revisions). Everything else is visible.
	tablePermission dim_age_group
		metadataPermission: none

	tablePermission mart_revisions
		metadataPermission: none

	tablePermission fct_weekly_cases
		columnPermission age_group_name = none
		columnPermission age_group_sort_order = none
